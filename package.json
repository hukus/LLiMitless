{
  "name": "llimitless-wiki-site",
  "private": true,
  "type": "module",
  "scripts": {
    "site:prepare": "node scripts/prepare-quartz-content.mjs --out .quartz-content",
    "site:validate": "node scripts/prepare-quartz-content.mjs --out .quartz-content && node scripts/validate-public-wiki.mjs --content .quartz-content",
    "site:build": "node scripts/build-quartz-site.mjs",
    "site:serve": "node scripts/build-quartz-site.mjs --serve"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  }
}
